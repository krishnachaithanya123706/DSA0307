def ends_with_ab(s):
    state = "q0"

    for ch in s:
        if state == "q0":
            if ch == "a":
                state = "q1"
            else:
                state = "q0"

        elif state == "q1":
            if ch == "b":
                state = "q2"
            elif ch == "a":
                state = "q1"
            else:
                state = "q0"

        elif state == "q2":
            if ch == "a":
                state = "q1"
            else:
                state = "q0"

    if state == "q2":
        print("Accepted (Ends with 'ab')")
    else:
        print("Rejected (Does not end with 'ab')")
string = input("Enter a string: ")
ends_with_ab(string)