def transform_tagger(sentence):
    words = sentence.split()
    tags = ["NOUN"] * len(words)
    for i, word in enumerate(words):
        if word.lower() in ["i", "you", "he", "she", "we", "they", "it"]:
            tags[i] = "PRON"
        elif word.lower() in ["a", "an", "the"]:
            tags[i] = "DET"
        elif word.endswith("ing") or word.endswith("ed"):
            tags[i] = "VERB"
        elif word.endswith("ly"):
            tags[i] = "ADV"

        elif word.isdigit():
            tags[i] = "NUM"
    print("\nTagged Sentence:")
    for word, tag in zip(words, tags):
        print(f"{word} -> {tag}")
sentence = input("Enter a sentence: ")
transform_tagger(sentence)